{
  "expo": {
    "name": "cineverse-ai",
    "slug": "cineverse-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cineverse_logo.png",
    "scheme": "cineverse-ai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/cineverse_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "package": "com.prathambindal.cineverseai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/cineverse_logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cineverse_logo.png",
          "imageWidth": 250,
          "imageHeight": 250,
          "resizeMode": "cover",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/cineverse_logo.png",
            "imageWidth": 250,
            "imageHeight": 250,
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          },
          "ios": {
            "tabletBackgroundColor": "#000000"
          },
          "android": {
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          }
        }
      ],
      "react-native-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
